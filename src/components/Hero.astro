---
import { profile } from "../data/portfolio";
import { withBase } from "../lib/links";
import Icon from "./Icon.astro";

const cv = withBase(profile.cvPath);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title reveal">
        I build <span class="accent-word">quality</span> code for communities and businesses.
      </h1>

      <p class="hero-sub reveal">
        Ten years of building through community projects, research and industry, with a
        <strong>Bachelors and Masters in Computer Science from Trinity College Dublin</strong>.
        I focus on dependable software that is useful, maintainable and straightforward to run.
      </p>

      <div class="hero-actions reveal">
        <a class="btn btn--primary" href={cv} target="_blank" rel="noreferrer">
          <Icon name="download" />
          Download CV
        </a>
        <a class="btn btn--secondary" href={withBase("#work")}>
          View work
          <Icon name="arrow-down" class="arrow" />
        </a>
        <span class="hero-social">
          <a class="icon-btn" href={`mailto:${profile.email}`} aria-label="Email Yuuv">
            <Icon name="mail" />
          </a>
          <a class="icon-btn" href={profile.github} target="_blank" rel="noreferrer" aria-label="GitHub">
            <Icon name="github" />
          </a>
          <a class="icon-btn" href={profile.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
            <Icon name="linkedin" />
          </a>
        </span>
      </div>

    </div>

    <aside class="practice-card reveal" aria-labelledby="practice-title">
      <div class="practice-intro">
        <h2 id="practice-title">Built around useful work.</h2>
        <p>Clear purpose, careful engineering and sensible maintenance.</p>
      </div>

      <div class="practice-list">
        <div class="practice-row">
          <span>01</span>
          <div>
            <b>Software for teams</b>
            <small>Practical tools shaped around how a business already works.</small>
          </div>
        </div>
        <div class="practice-row">
          <span>02</span>
          <div>
            <b>Community products</b>
            <small>Focused open source tools for specific, real needs.</small>
          </div>
        </div>
        <div class="practice-row">
          <span>03</span>
          <div>
            <b>Applied AI and data</b>
            <small>Used where it improves the product, with people in control.</small>
          </div>
        </div>
      </div>

      <div class="practice-footer">
        <span>Based in Dublin</span>
        <a href={withBase("#solutions")}>See solutions <Icon name="arrow-down" /></a>
      </div>
    </aside>
  </div>
</section>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/links";

const demoUrl = withBase("demos/leadfinder.html");
const solutionsUrl = `${withBase("")}#solutions`;
const capabilities = [
  ["Discover", "Find buying and expansion signals"],
  ["Verify", "Check the company and supporting evidence"],
  ["Reach", "Locate a published email, form, or phone"],
  ["Draft", "Prepare outreach while you stay in control"],
];
---

<BaseLayout
  title="LeadFinder interactive demo · Yuuv Jauhari"
  description="Explore LeadFinder through a responsive, fully mocked interactive product demo. No backend or live company data is used."
>
  <main id="main" class="demo-page">
    <section class="demo-intro" aria-labelledby="demo-title">
      <div class="container demo-intro-grid">
        <div>
          <h1 id="demo-title">Meet <span class="accent-word">LeadFinder</span>.</h1>
          <p>
            See how a team can move from a public growth signal to a verified company, a real
            contact route, and a first draft while keeping control of the send button.
          </p>
          <div class="demo-intro-actions">
            <a class="btn btn--secondary" href={solutionsUrl}>
              <Icon name="arrow-left" /> Back to Solutions
            </a>
            <a class="btn btn--primary" href={demoUrl} target="_blank" rel="noreferrer">
              Open demo full screen <Icon name="arrow-up-right" />
            </a>
          </div>
        </div>

        <ul class="demo-capabilities" aria-label="LeadFinder capabilities">
          {capabilities.map(([title, description], index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <b>{title}</b>
              <small>{description}</small>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="demo-stage" aria-labelledby="demo-stage-title">
      <div class="container">
        <div class="demo-stage-bar">
          <div>
            <span id="demo-stage-title">Live walkthrough</span>
          </div>
        </div>
        <div class="demo-frame">
          <iframe
            src={demoUrl}
            title="Interactive LeadFinder product demo"
            loading="eager"
          ></iframe>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .demo-page {
    padding-top: var(--nav-h);
  }
  .demo-intro {
    padding-block: clamp(2rem, 5vw, 4.5rem);
  }
  .demo-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(310px, 0.92fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .demo-intro h1 {
    margin-top: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 2rem + 3vw, 4.8rem);
    line-height: 0.98;
  }
  .demo-intro p {
    max-width: 62ch;
    margin-top: 1.15rem;
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.14rem);
  }
  .demo-intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
  .demo-intro-actions .icon {
    width: 1rem;
    height: 1rem;
  }
  .demo-capabilities {
    display: grid;
    gap: 0.65rem;
  }
  .demo-capabilities li {
    display: grid;
    grid-template-columns: 2.2rem minmax(78px, 0.45fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(0.7rem, 1.5vw, 1rem);
    min-height: 72px;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.28)),
      rgba(255, 255, 255, 0.34);
    box-shadow: 0 16px 34px -30px rgba(38, 53, 42, 0.7), inset 0 1px 0 #fff;
    backdrop-filter: saturate(2) blur(20px);
    -webkit-backdrop-filter: saturate(2) blur(20px);
  }
  .demo-capabilities li > span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    color: var(--terra-ink);
  }
  .demo-capabilities b,
  .demo-capabilities small {
    display: block;
  }
  .demo-capabilities b {
    color: var(--ink);
    font-size: 0.98rem;
  }
  .demo-capabilities small {
    color: var(--muted);
    font-size: 0.77rem;
    line-height: 1.45;
  }
  .demo-stage {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .demo-stage-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    color: var(--body);
    border: 1px solid rgba(255, 255, 255, 0.88);
    border-bottom: 0;
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    background: rgba(255, 255, 255, 0.48);
    box-shadow: inset 0 1px 0 #fff;
    backdrop-filter: saturate(2) blur(24px);
    -webkit-backdrop-filter: saturate(2) blur(24px);
  }
  .demo-stage-bar span {
    display: block;
  }
  .demo-stage-bar span {
    color: var(--ink);
    font-weight: 600;
  }
  .demo-frame {
    position: relative;
    overflow: hidden;
    min-height: 760px;
    height: min(920px, calc(100dvh - 112px));
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 0 0 var(--r-lg) var(--r-lg);
    background: #eef0e6;
    box-shadow: var(--shadow-lg), inset 0 1px 0 #fff;
  }
  .demo-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #eef0e6;
  }

  @media (max-width: 820px) {
    .demo-intro-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .demo-frame {
      height: max(760px, calc(100dvh - 88px));
    }
  }
  @media (max-width: 560px) {
    .demo-page {
      padding-top: 66px;
    }
    .demo-intro-actions .btn {
      width: 100%;
      justify-content: center;
    }
    .demo-capabilities li {
      grid-template-columns: 2rem 1fr;
      min-height: 82px;
      padding: 0.8rem 0.9rem;
    }
    .demo-capabilities small {
      grid-column: 2;
      margin-top: -0.45rem;
    }
    .demo-stage > .container {
      padding-inline: 0;
    }
    .demo-stage-bar {
      align-items: flex-start;
      border-radius: 0;
      padding-inline: var(--gutter);
    }
    .demo-frame {
      min-height: 820px;
      height: max(820px, calc(100dvh - 66px));
      border-inline: 0;
      border-radius: 0;
    }
  }
</style>

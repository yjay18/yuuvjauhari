---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/links";

const demoUrl = withBase("demos/leadfinder.html");
const solutionsUrl = `${withBase("")}#solutions`;
const capabilities = [
  ["Discover", "Find buying and expansion signals"],
  ["Verify", "Check the company and supporting evidence"],
  ["Reach", "Locate a published email, form, or phone"],
  ["Draft", "Prepare outreach while you stay in control"],
];
---

<BaseLayout
  title="LeadFinder interactive demo · Yuuv Jauhari"
  description="Explore LeadFinder through a responsive, fully mocked interactive product demo. No backend or live company data is used."
>
  <main id="main" class="demo-page">
    <section class="demo-intro" aria-labelledby="demo-title">
      <div class="container demo-intro-grid">
        <div>
          <span class="eyebrow">Interactive product demo</span>
          <h1 id="demo-title">Meet <span class="accent-word">LeadFinder</span>.</h1>
          <p>
            See how a team can move from a public growth signal to a verified company, a real
            contact route, and a first draft&mdash;without giving up control of the send button.
          </p>
          <div class="demo-intro-actions">
            <a class="btn btn--secondary" href={solutionsUrl}>
              <Icon name="arrow-left" /> Back to Solutions
            </a>
            <a class="btn btn--primary" href={demoUrl} target="_blank" rel="noreferrer">
              Open demo full screen <Icon name="arrow-up-right" />
            </a>
          </div>
        </div>

        <ul class="demo-capabilities" aria-label="LeadFinder capabilities">
          {capabilities.map(([title, description], index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div><b>{title}</b><small>{description}</small></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="demo-stage" aria-labelledby="demo-stage-title">
      <div class="container">
        <div class="demo-stage-bar">
          <div>
            <span id="demo-stage-title">Live walkthrough</span>
            <small>All companies, signals, scores, and contact details are mock data.</small>
          </div>
          <span class="demo-status"><i></i> Runs locally in your browser</span>
        </div>
        <div class="demo-frame">
          <iframe
            src={demoUrl}
            title="Interactive LeadFinder product demo"
            loading="eager"
          ></iframe>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .demo-page {
    padding-top: var(--nav-h);
  }
  .demo-intro {
    padding-block: clamp(2rem, 5vw, 4.5rem);
  }
  .demo-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(310px, 0.92fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
  }
  .demo-intro h1 {
    margin-top: 0.85rem;
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 2rem + 3vw, 4.8rem);
    line-height: 0.98;
  }
  .demo-intro p {
    max-width: 62ch;
    margin-top: 1.15rem;
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.14rem);
  }
  .demo-intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
  .demo-intro-actions .icon {
    width: 1rem;
    height: 1rem;
  }
  .demo-capabilities {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.4);
    box-shadow: var(--shadow), inset 0 1px 0 #fff;
    backdrop-filter: saturate(2) blur(24px);
    -webkit-backdrop-filter: saturate(2) blur(24px);
  }
  .demo-capabilities li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    min-height: 112px;
    padding: 1rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .demo-capabilities li:nth-child(2n) {
    border-right: 0;
  }
  .demo-capabilities li:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  .demo-capabilities li > span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--terra-ink);
  }
  .demo-capabilities b,
  .demo-capabilities small {
    display: block;
  }
  .demo-capabilities b {
    color: var(--ink);
    font-size: 0.92rem;
  }
  .demo-capabilities small {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.77rem;
    line-height: 1.45;
  }
  .demo-stage {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .demo-stage-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    color: var(--body);
    border: 1px solid rgba(255, 255, 255, 0.88);
    border-bottom: 0;
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    background: rgba(255, 255, 255, 0.48);
    box-shadow: inset 0 1px 0 #fff;
    backdrop-filter: saturate(2) blur(24px);
    -webkit-backdrop-filter: saturate(2) blur(24px);
  }
  .demo-stage-bar span,
  .demo-stage-bar small {
    display: block;
  }
  .demo-stage-bar span {
    color: var(--ink);
    font-weight: 600;
  }
  .demo-stage-bar small {
    margin-top: 0.1rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .demo-status {
    display: inline-flex !important;
    align-items: center;
    gap: 0.45rem;
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400 !important;
    color: var(--muted) !important;
  }
  .demo-status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--slate);
    box-shadow: 0 0 0 4px var(--slate-soft);
  }
  .demo-frame {
    position: relative;
    overflow: hidden;
    min-height: 760px;
    height: min(920px, calc(100dvh - 112px));
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 0 0 var(--r-lg) var(--r-lg);
    background: #eef0e6;
    box-shadow: var(--shadow-lg), inset 0 1px 0 #fff;
  }
  .demo-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #eef0e6;
  }

  @media (max-width: 820px) {
    .demo-intro-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .demo-frame {
      height: max(760px, calc(100dvh - 88px));
    }
  }
  @media (max-width: 560px) {
    .demo-page {
      padding-top: 66px;
    }
    .demo-intro-actions .btn {
      width: 100%;
      justify-content: center;
    }
    .demo-capabilities {
      grid-template-columns: 1fr;
    }
    .demo-capabilities li,
    .demo-capabilities li:nth-child(2n),
    .demo-capabilities li:nth-last-child(-n + 2) {
      min-height: 86px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .demo-capabilities li:last-child {
      border-bottom: 0;
    }
    .demo-stage > .container {
      padding-inline: 0;
    }
    .demo-stage-bar {
      align-items: flex-start;
      border-radius: 0;
      padding-inline: var(--gutter);
    }
    .demo-status {
      display: none !important;
    }
    .demo-frame {
      min-height: 820px;
      height: max(820px, calc(100dvh - 66px));
      border-inline: 0;
      border-radius: 0;
    }
  }
</style>

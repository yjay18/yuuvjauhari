---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FlagshipCard from "../components/FlagshipCard.astro";
import Icon from "../components/Icon.astro";
import {
  archiveFilters,
  communityHighlights,
  education,
  experience,
  flagshipProjects,
  profile,
  projects,
  publications,
  skillGroups,
} from "../data/portfolio";
import { resolveUrl, withBase } from "../lib/links";
import { Image } from "astro:assets";
import kinoirLogo from "../../products/kinoir/logo copy.png";
import pitCrewLogo from "../../products/pitcrew/pit-crew-logo copy.png";

const cv = withBase(profile.cvPath);
const offerings = [
  {
    name: "Kinoir",
    tone: "kinoir",
    logo: kinoirLogo,
    url: "https://yjay18.github.io/Kinoir/",
    description:
      "Kinoir turns a folder of local movies and shows into a polished, private streaming library. It cleans messy filenames, finds metadata, and creates hover previews on your Mac. Grounded Ollama discovery and Kinoir Air keep exploration and home network streaming private, open source, native to macOS, and free from accounts.",
  },
  {
    name: "Pit Crew",
    tone: "pitcrew",
    logo: pitCrewLogo,
    url: "https://yjay18.github.io/ballxpit-run-tracker/",
    description:
      "Pit Crew is a live BALL x PIT companion for faster decisions during a run. Track characters, balls, passives, levels, and available evolutions, then compare the upgrades the game offers with your current build. Recommendations respond to what you already have so the next useful choice stays easy to see.",
  },
];
---

<BaseLayout>
  <main id="main">
    <Hero />

    {/* ---- Solutions ---------------------------------------------------- */}
    <section class="section product-section" id="solutions" aria-labelledby="solutions-title">
      <div class="container">
        <div class="section-head reveal">
          <span class="index">01 · Client software</span>
          <h2 class="section-title" id="solutions-title">Solutions</h2>
          <p class="lede">Custom built affordable Software offerings for growing and mid sized companies</p>
        </div>

        <article class="solution-card reveal">
          <div class="solution-identity" aria-label="LeadFinder">
            <h3 class="leadfinder-wordmark"><span>Lead</span><strong>Finder</strong></h3>
          </div>
          <div class="solution-copy">
            <p>
              A private workspace that finds public buying and expansion signals, verifies each
              company, locates a real contact route, and scores the opportunity with AI. It can draft
              a first contact message and assist with the company&rsquo;s own form, but it never sends or
              submits anything for you.
            </p>
            <div class="solution-actions">
              <a class="btn btn--primary" href={withBase("#contact")}>
                <Icon name="mail" /> Contact me for pricing
              </a>
              <a class="btn btn--secondary" href={withBase("leadfinder-demo/")}>
                Try the interactive demo <Icon name="arrow-up-right" />
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>

    {/* ---- Open-source offerings --------------------------------------- */}
    <section class="section product-section" id="offerings" aria-labelledby="offerings-title">
      <div class="container">
        <div class="section-head reveal">
          <span class="index">02 · Community products</span>
          <h2 class="section-title" id="offerings-title">Offerings</h2>
          <p class="lede">Open Source Free Product Offerings to give back to the community &lt;3</p>
        </div>

        <div class="offerings-grid">
          {offerings.map((product) => (
            <article class={`offering-card offering-card--${product.tone} reveal`} tabindex="0">
              <div class="offering-logo-stage">
                <Image
                  src={product.logo}
                  alt={`${product.name} logo`}
                  width={410}
                  height={410}
                  format="webp"
                  loading="lazy"
                />
              </div>
              <div class="offering-reveal">
                <div class="offering-copy">
                  <span class="product-label">Free · Open source</span>
                  <h3>{product.name}</h3>
                  <p>{product.description}</p>
                  <a class="case-link" href={product.url} target="_blank" rel="noreferrer">
                    Visit {product.name} <Icon name="arrow-up-right" />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="offering-hint reveal">Hover a logo to learn more.</p>
      </div>
    </section>

    {/* ---- Flagship work ------------------------------------------------ */}
    <section class="section" id="work" aria-labelledby="work-title">
      <div class="container">
        <div class="section-head reveal">
          <span class="index">03 · Selected work</span>
          <h2 class="section-title" id="work-title">Flagship projects</h2>
          <p class="lede">Selected work across research, ML systems, and applied engineering.</p>
        </div>

        <div class="work-grid">
          {flagshipProjects.map((project, i) => <FlagshipCard project={project} index={i} />)}
        </div>
        <div class="work-more reveal">
          <a class="btn btn--secondary" href={withBase("#archive")}>
            See all projects <Icon name="arrow-down" />
          </a>
        </div>
      </div>
    </section>

    {/* ---- Experience --------------------------------------------------- */}
    <section class="section" id="experience" aria-labelledby="xp-title">
      <div class="container">
        <div class="section-head reveal">
          <span class="index">04 · Track record</span>
          <h2 class="section-title" id="xp-title">Experience</h2>
          <p class="lede">Across industry and research.</p>
        </div>

        <div class="xp-list">
          {experience.map((xp) => (
            <article class="xp reveal">
              <div class="xp-meta">
                <p class="yr">{xp.year}</p>
                <p class="co">{xp.company}</p>
                <p class="pl">{xp.period} · {xp.location}</p>
              </div>
              <div class="xp-body">
                <div class="role-row">
                  <span class="role">{xp.role}</span>
                  {xp.tag && <span class="tag">{xp.tag}</span>}
                </div>
                <p class="xp-summary">{xp.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ---- Education ------------------------------------------------------- */}
    <section class="section" id="education" aria-labelledby="edu-title">
      <div class="container">
        <div class="section-head reveal">
          <span class="index">05 · Education</span>
          <h2 class="section-title" id="edu-title">Education</h2>
          <p class="lede">Where the foundation was built.</p>
        </div>

        <div class="edu-grid">
          {education.map((edu) => (
            <article class="edu-card reveal">
              <div class="edu-topline">
                <span>{edu.period}</span>
                <span>{edu.location}</span>
              </div>
              <div class="edu-main">
                <h3>{edu.institution}</h3>
                <p class="edu-degree">{edu.qualification}</p>
                {edu.tag && <span class="tag">{edu.tag}</span>}
              </div>
              <p>{edu.summary}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ---- Publications ------------------------------------------------- */}
    <section class="section" id="research" aria-labelledby="research-title">
      <div class="container">
        <div class="section-head reveal">
          <span class="index">06 · Research</span>
          <h2 class="section-title" id="research-title">Publications</h2>
          <p class="lede">Peer-reviewed, thesis, and preprint work.</p>
        </div>

        <div class="pub-list">
          {publications.map((pub) => {
            const Tag = pub.url ? "a" : "div";
            const attrs = pub.url
              ? { href: resolveUrl(pub.url), target: "_blank", rel: "noreferrer" }
              : {};
            return (
              <Tag class="pub reveal" {...attrs}>
                <div class="pub-when">
                  <span>{pub.date}</span>
                  {pub.status && <span class="status">{pub.status}</span>}
                </div>
                <div class="pub-main">
                  <h3>{pub.title}</h3>
                  {pub.subtitle && <p>{pub.subtitle}</p>}
                  <p class="venue">{pub.venue}</p>
                </div>
                {pub.url && <Icon name="arrow-up-right" class="pub-go" />}
              </Tag>
            );
          })}
        </div>
      </div>
    </section>

    {/* ---- All projects ------------------------------------------------- */}
    <section class="section" id="archive" aria-labelledby="archive-title">
      <div class="container">
        <div class="archive-head reveal">
          <div class="section-head" style="margin-bottom:0">
            <span class="index">07 · All work</span>
            <h2 class="section-title" id="archive-title">All projects</h2>
            <p class="lede">The complete set, from flagship work to experiments and community projects.</p>
          </div>
          <div class="filters" role="group" aria-label="Filter projects" data-filters>
            {archiveFilters.map((f, i) => (
              <button class="filter" type="button" data-filter={f} aria-pressed={i === 0 ? "true" : "false"}>
                {f}
              </button>
            ))}
          </div>
        </div>

        <div class="archive-grid" data-archive>
          {projects.map((p) => {
            const repo = p.links?.find((link) => link.kind === "repo");
            const destination = repo?.url ?? p.externalUrl;
            const actionLabel = repo ? "GitHub →" : p.externalUrl ? "Open project →" : null;
            const Tag = destination ? "a" : "article";
            const linkAttrs = destination
              ? { href: resolveUrl(destination), target: "_blank", rel: "noreferrer" }
              : {};
            return (
              <Tag class="acard reveal" {...linkAttrs} data-cats={p.categories.join("|")}>
                {p.flagship && <span class="ac-flag">Flagship</span>}
                <span class="ac-eyebrow">{p.eyebrow}</span>
                <h3>{p.title}</h3>
                <p>{p.subtitle ?? p.summary}</p>
                <span class="ac-foot">
                  <span>{p.categories[0]}</span>
                  {actionLabel && <span class="go">{actionLabel}</span>}
                </span>
              </Tag>
            );
          })}
          {communityHighlights.map((c) => (
            <div class="acard acard--static reveal" data-cats={c.categories.join("|")}>
              <span class="ac-eyebrow">{c.eyebrow}</span>
              <h3>{c.title}</h3>
              <p>{c.summary}</p>
              <span class="ac-foot">
                <span>{c.period}</span>
                <span>{c.categories[0]}</span>
              </span>
            </div>
          ))}
          <p class="archive-empty" data-archive-empty hidden>No projects in this category.</p>
        </div>
      </div>
    </section>

    {/* ---- Skills ------------------------------------------------------- */}
    <section class="section" id="skills" aria-labelledby="skills-title">
      <div class="container">
        <div class="section-head reveal">
          <span class="index">08 · Capabilities</span>
          <h2 class="section-title" id="skills-title">Skills</h2>
          <p class="lede">Grouped by area, with the projects where each was applied.</p>
        </div>

        <div class="skills-grid">
          {skillGroups.map((group) => (
            <article class="skill-card reveal">
              <h3>{group.title}</h3>
              <p class="caption">{group.caption}</p>
              <ul class="tags">
                {group.skills.map((s) => <li>{s}</li>)}
              </ul>
              <div class="applied">
                <span class="lbl">Applied in</span>
                {group.appliedIn.map((p) => (
                  <a href={resolveUrl(p.url)} target="_blank" rel="noreferrer">
                    {p.label}
                    <Icon name="arrow-up-right" class="arrow" />
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ---- Contact ------------------------------------------------------ */}
    <section class="section" id="contact" aria-labelledby="contact-title">
      <div class="container contact-grid">
        <div class="contact-lead reveal">
          <span class="eyebrow">09 · Contact</span>
          <h2 id="contact-title" style="margin-top:0.9rem">
            Have something <span class="accent-word">useful</span> to build?
          </h2>
          <p>
            If you have a practical software problem, a product idea or an open source collaboration
            in mind, I am happy to talk. I work across software engineering, data and applied AI,
            from the first decisions through to dependable delivery.
          </p>
          <div class="contact-actions">
            <a class="btn btn--primary" href={`mailto:${profile.email}`}>
              <Icon name="mail" /> Email me
            </a>
            <button class="btn btn--secondary copy-mail" type="button" data-copy={profile.email}>
              <Icon name="copy" /> Copy email
            </button>
            <span class="copy-ok" data-copy-ok aria-live="polite"></span>
            <a class="btn btn--secondary" href={cv} target="_blank" rel="noreferrer">
              <Icon name="download" /> Download CV
            </a>
          </div>
        </div>

        <aside class="profile-card reveal" aria-label="Professional profile">
          <dl>
            <div>
              <dt>Focus</dt>
              <dd>Software products, applied AI and data</dd>
            </div>
            <div>
              <dt>Experience</dt>
              <dd>Ten years across community projects, research and industry</dd>
            </div>
            <div>
              <dt>Based</dt>
              <dd>{profile.location}</dd>
            </div>
            <div>
              <dt>Education</dt>
              <dd>Bachelors and Masters in Computer Science, Trinity College Dublin · {profile.degreeNote}</dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
            </div>
            <div>
              <dt>Updated</dt>
              <dd>{profile.lastUpdated}</dd>
            </div>
          </dl>
          <div class="profile-actions">
            <a class="btn btn--primary" href={cv} target="_blank" rel="noreferrer">
              <Icon name="download" /> CV
            </a>
            <a class="btn btn--secondary" href={`mailto:${profile.email}`}>
              <Icon name="mail" /> Email
            </a>
            <a class="btn btn--secondary" href={profile.github} target="_blank" rel="noreferrer">
              <Icon name="github" /> GitHub
            </a>
            <a class="btn btn--secondary" href={profile.linkedin} target="_blank" rel="noreferrer">
              <Icon name="linkedin" /> LinkedIn
            </a>
          </div>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
